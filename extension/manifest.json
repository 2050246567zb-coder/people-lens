{
  "manifest_version": 3,
  "name": "人物速览 · 小红书回复助手",
  "version": "0.1.8",
  "description": "回复前查看对方的公开内容速览。自带 AI API，支持最近、最早和混合分析。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.xiaohongshu.com/*", "https://*.xhscdn.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://www.xiaohongshu.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_title": "人物速览", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
